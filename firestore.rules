rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function hasEditorRecord(path) {
      return signedIn()
        && exists(path)
        && (
          get(path).data.canEdit == true
          || get(path).data.edit == true
          || get(path).data.role in ['admin', 'editor', 'edit']
          || (
            get(path).data.keys().hasAny(['roles'])
            && get(path).data.roles is list
            && get(path).data.roles.hasAny(['admin', 'editor', 'edit'])
          )
          || (
            get(path).data.keys().hasAny(['permissions'])
            && get(path).data.permissions is list
            && get(path).data.permissions.hasAny(['admin', 'editor', 'edit'])
          )
        );
    }

    function isEditor() {
      return isAdmin()
        || hasEditorRecord(/databases/$(database)/documents/editorPermissions/$(request.auth.uid))
        || hasEditorRecord(/databases/$(database)/documents/userPermissions/$(request.auth.uid))
        || hasEditorRecord(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownsExistingCharacter() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewCharacter() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function controlsExistingCharacter() {
      return signedIn()
        && resource.data.keys().hasAny(['controlUserIds'])
        && resource.data.controlUserIds is list
        && request.auth.uid in resource.data.controlUserIds;
    }

    function viewsExistingCharacter() {
      return signedIn()
        && resource.data.keys().hasAny(['viewUserIds'])
        && resource.data.viewUserIds is list
        && request.auth.uid in resource.data.viewUserIds;
    }

    function controllerSafeUpdate() {
      return controlsExistingCharacter()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'ownerEmail',
          'ownerTransferredAt',
          'controlUserIds'
        ]);
    }

    function isCampaignDm(campaignId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campaigns/$(campaignId))
        && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUserIds;
    }

    function isCampaignMember(campaignId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campaigns/$(campaignId))
        && (
          request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUserIds
          || request.auth.uid in get(/databases/$(database)/documents/campaigns/$(campaignId)).data.playerUserIds
        );
    }

    match /characters/{characterId} {
      allow read: if isAdmin()
        || ownsExistingCharacter()
        || controlsExistingCharacter()
        || viewsExistingCharacter()
        || resource.data.visibility == 'public';

      allow create: if isAdmin() || ownsNewCharacter();

      allow update: if isAdmin()
        || ownsExistingCharacter()
        || controllerSafeUpdate();

      allow delete: if isAdmin()
        || ownsExistingCharacter()
        || controlsExistingCharacter();
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'provider',
          'lastLoginAt'
        ]);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'provider',
          'lastLoginAt'
        ]);

      allow delete: if isAdmin();
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /editorPermissions/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /userPermissions/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /userDiceSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.dmUserIds)
        || (signedIn() && request.auth.uid in resource.data.playerUserIds);

      allow create: if signedIn()
        && request.resource.data.id == campaignId
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.dmUserIds;

      allow update: if isAdmin()
        || (
          signedIn()
          && (
            request.auth.uid in resource.data.dmUserIds
            || request.auth.uid in resource.data.playerUserIds
            || request.auth.uid in request.resource.data.playerUserIds
          )
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /parties/{partyId} {
      allow read: if isAdmin()
        || isCampaignDm(resource.data.campaignId)
        || (
          isCampaignMember(resource.data.campaignId)
          && (resource.data.visibility == 'public' || resource.data.createdBy == request.auth.uid)
        );

      allow create: if signedIn()
        && request.resource.data.id == partyId
        && request.resource.data.createdBy == request.auth.uid
        && isCampaignMember(request.resource.data.campaignId);

      allow update: if isAdmin()
        || isCampaignDm(resource.data.campaignId)
        || isCampaignMember(resource.data.campaignId)
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      allow delete: if isAdmin()
        || isCampaignDm(resource.data.campaignId)
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /skillTrees/{treeId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /sessions/{sessionCode} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == sessionCode
        && request.resource.data.id == sessionCode;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'characterIds',
          'updatedAt'
        ]);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
