rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function hasEditorRecord(path) {
      return signedIn()
        && exists(path)
        && (
          get(path).data.canEdit == true
          || get(path).data.edit == true
          || get(path).data.role in ['admin', 'editor', 'edit']
          || (
            get(path).data.keys().hasAny(['roles'])
            && get(path).data.roles is list
            && get(path).data.roles.hasAny(['admin', 'editor', 'edit'])
          )
          || (
            get(path).data.keys().hasAny(['permissions'])
            && get(path).data.permissions is list
            && get(path).data.permissions.hasAny(['admin', 'editor', 'edit'])
          )
        );
    }

    function isEditor() {
      return isAdmin()
        || hasEditorRecord(/databases/$(database)/documents/editorPermissions/$(request.auth.uid))
        || hasEditorRecord(/databases/$(database)/documents/userPermissions/$(request.auth.uid))
        || hasEditorRecord(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownsExistingCharacter() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewCharacter() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function controlsExistingCharacter() {
      return signedIn()
        && resource.data.keys().hasAny(['controlUserIds'])
        && resource.data.controlUserIds is list
        && request.auth.uid in resource.data.controlUserIds;
    }

    function viewsExistingCharacter() {
      return signedIn()
        && resource.data.keys().hasAny(['viewUserIds'])
        && resource.data.viewUserIds is list
        && request.auth.uid in resource.data.viewUserIds;
    }

    function controllerSafeUpdate() {
      return controlsExistingCharacter()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userId',
          'ownerEmail',
          'ownerTransferredAt',
          'controlUserIds'
        ]);
    }

    function isCampaignDm(campaignId) {
      return signedIn()
        && exists(/databases/$(database)/documents/campaigns/$(campaignId))
        && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUserIds.hasAny([request.auth.uid]);
    }

    match /characters/{characterId} {
      allow read: if isAdmin()
        || ownsExistingCharacter()
        || controlsExistingCharacter()
        || viewsExistingCharacter()
        || resource.data.visibility == 'public';

      allow create: if isAdmin() || ownsNewCharacter();

      allow update: if isAdmin()
        || ownsExistingCharacter()
        || controllerSafeUpdate();

      allow delete: if isAdmin()
        || ownsExistingCharacter()
        || controlsExistingCharacter();
    }

    match /galleryImages/{imageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == imageId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'url', 'thumbUrl', 'label', 'tags', 'createdAt', 'updatedAt'])
        && request.resource.data.url is string
        && request.resource.data.url.matches('https?://.*')
        && request.resource.data.url.size() <= 4096
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 100;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == imageId
        && request.resource.data.keys().hasOnly(['id', 'userId', 'url', 'thumbUrl', 'label', 'tags', 'createdAt', 'updatedAt'])
        && request.resource.data.url is string
        && request.resource.data.url.matches('https?://.*')
        && request.resource.data.url.size() <= 4096
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 100;
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function galleryReactionBefore(uid, imageKey) {
      let path = /databases/$(database)/documents/users/$(uid)/galleryReactions/$(imageKey);
      return exists(path) ? get(path).data : {'liked': false, 'favorite': false, 'rockets': 0};
    }
    function galleryLikesBefore(imageKey) {
      let path = /databases/$(database)/documents/galleryLikeCounts/$(imageKey);
      return exists(path) ? get(path).data.likes : 0;
    }
    function galleryLikeDelta(before, after) {
      return (after.liked ? 1 : 0) - (before.liked ? 1 : 0);
    }
    match /users/{uid}/galleryReactions/{imageKey} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && imageKey.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['liked', 'favorite', 'rockets', 'updatedAt'])
        && request.resource.data.liked is bool
        && request.resource.data.favorite is bool
        && request.resource.data.rockets is int
        && request.resource.data.rockets >= 0
        && request.resource.data.rockets <= 9007199254740991
        && request.resource.data.updatedAt is number
        && request.resource.data.rockets >= galleryReactionBefore(uid, imageKey).rockets
        && request.resource.data.rockets <= galleryReactionBefore(uid, imageKey).rockets + 1
        && (request.resource.data.liked == galleryReactionBefore(uid, imageKey).liked
          || getAfter(/databases/$(database)/documents/galleryLikeCounts/$(imageKey)).data.likes
            == galleryLikesBefore(imageKey) + galleryLikeDelta(galleryReactionBefore(uid, imageKey), request.resource.data));
      allow delete: if false;
    }
    match /galleryLikeCounts/{imageKey} {
      allow read: if true;
      allow create, update: if signedIn()
        && imageKey.matches('[a-f0-9]{64}')
        && request.resource.data.keys().hasOnly(['likes'])
        && request.resource.data.likes is int && request.resource.data.likes >= 0
        && galleryLikeDelta(galleryReactionBefore(request.auth.uid, imageKey), getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/galleryReactions/$(imageKey)).data) != 0
        && request.resource.data.likes == galleryLikesBefore(imageKey)
          + galleryLikeDelta(galleryReactionBefore(request.auth.uid, imageKey), getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/galleryReactions/$(imageKey)).data);
      allow delete: if false;
    }

    match /galleryTags/{tagId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'category'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 64
        && request.resource.data.category in ['character', 'meta', 'general', 'character-specific']
        && (!exists(/databases/$(database)/documents/galleryTags/$(tagId)) || request.resource.data.name == resource.data.name);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'provider',
          'lastLoginAt'
        ]);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'provider',
          'lastLoginAt'
        ]);

      allow delete: if isAdmin();
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /editorPermissions/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /userPermissions/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /userDiceSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.id == campaignId
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.dmUserIds;

      allow update: if signedIn();

      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /campaignInvites/{inviteCode} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.inviteCode == inviteCode;

      allow delete: if isAdmin()
        || (signedIn() && isCampaignDm(resource.data.campaignId));
    }

    match /parties/{partyId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.id == partyId
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn();

      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /skillTrees/{treeId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /sessions/{sessionCode} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.code == sessionCode
        && request.resource.data.id == sessionCode;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'characterIds',
          'updatedAt'
        ]);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
